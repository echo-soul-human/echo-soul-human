    "ChatError": [
      { "name": "code", "type": "string", "_": "取值见 ErrorCode 枚举；类型留 string，为的是新增码不把旧客户端编译打断" },
      { "name": "msg", "type": "string", "_": "给用户看的话，不是日志" },
      { "name": "partial", "type": "boolean", "optional": true, "_": "true 表示已产出的部分要保留显示，并给续接入口" }
