# 星回 EchoSoul · 环境变量模板（可入库，全部留空）
# 复制为 .env 后填值。.env 已被 .gitignore 排除。

# ── 爱发电 ──
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=
AFDIAN_WEBHOOK_PATH=/functions/v1/afdian-webhook
AFDIAN_OAUTH_CLIENT_ID=
AFDIAN_OAUTH_CLIENT_SECRET=
AFDIAN_OAUTH_REDIRECT_URI=

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 模型 ──
DEEPSEEK_API_KEY=

# ── Web Push ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── BYOK 信封加密主密钥（仅服务端）──
BYOK_MASTER_KEY=
