<?xml version="1.0" encoding="utf-8"?>
<!--
  Compose 应用不使用 AppCompat 主题；Theme.Material3.DayNight.NoActionBar 由
  material3 库提供（本文件不重复声明，靠 AAR 合入）。
  ★ colorDynamicPalette=false：禁用 Material You 动态取色（分册 §9）。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.EchoSoul" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!--
      冷启动 ≤1.5s 的 P0 要求：首帧之前唯一能被看到的就是 windowBackground，
      让它等于 tier1.color.paper，就不存在"先白一下再变纸色"的闪。
      Theme.SplashScreen 来自 androidx.core:core-splashscreen 之外的实现成本更高，
      因此这里用 windowBackground 同色 + postSplashScreen 直切，不引入额外依赖。
    -->
    <style name="Theme.EchoSoul.Launch" parent="Theme.EchoSoul">
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
