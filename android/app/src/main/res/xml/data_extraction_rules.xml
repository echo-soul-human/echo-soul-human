<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false，因此这两个规则只影响设备迁移（D2R）一处。
  刻意排除：数据库与加密偏好里的会话令牌 —— 换机不该把登录态一起搬走。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="rootfile" path="**.db" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="echosoul_device.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
